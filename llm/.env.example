# O modelo deve estar baixado localmente no servidor Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Sem GPU o qwen3:4b leva minutos por resposta fundamentada.
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_OUTPUT_TOKENS=768

# Origens do frontend autorizadas a chamar o backend durante o desenvolvimento.
CHATBOT_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Modelo local de embeddings usado pelo RAG (mesmo servidor Ollama).
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Base vetorial local (docker compose up -d rag-db). Publicada apenas em
# 127.0.0.1: o conteudo indexado e confidencial.
RAG_ENABLED=true
RAG_DATABASE_URL=postgresql://thermal:thermal@127.0.0.1:5435/thermal_rag
RAG_CORPUS_DIR=docs
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45
# Consulta a documentacao mesmo quando o modelo nao pede a ferramenta.
RAG_ALWAYS_RETRIEVE=true
