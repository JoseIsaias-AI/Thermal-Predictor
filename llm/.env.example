# O modelo deve estar baixado localmente no servidor Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Sem GPU o qwen3:4b leva minutos por resposta fundamentada.
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_OUTPUT_TOKENS=768

# Origens do frontend autorizadas a chamar o backend durante o desenvolvimento.
CHATBOT_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# Modelo local de embeddings usado pelo RAG (mesmo servidor Ollama).
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Mantem os modelos carregados entre perguntas (evita ~25s de recarga).
OLLAMA_KEEP_ALIVE=30m

# Base vetorial local (docker compose up -d rag-db), publicada apenas em
# 127.0.0.1. Desligada por padrao: o repositorio nao traz documentos para indexar
# (veja "O corpus" no README do chatbot).
RAG_ENABLED=false
RAG_DATABASE_URL=postgresql://thermal:thermal@127.0.0.1:5435/thermal_rag
RAG_CORPUS_DIR=docs
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45
# Consulta a documentacao mesmo quando o modelo nao pede a ferramenta.
RAG_ALWAYS_RETRIEVE=true

# Dataset auditado de ensaios e modelo final de cada dataset, gerados pelos
# scripts de sintetico/ (nao versionados; os mesmos que a API do painel usa).
# Os caminhos sao relativos a este diretorio (llm).
DATASET_ENABLED=true
DATASET_PATH=../dataset_completo_com_flags_de_auditoria.csv
PREDICTION_ENABLED=true
MODELS_DIR=../modelos/modelo_final
